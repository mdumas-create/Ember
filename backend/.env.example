PORT=3000
NODE_ENV=development

# Database (Supabase)
# DATABASE_URL: Use Transaction mode (port 6543) for the app
# DIRECT_URL: Use Session mode (port 5432) for migrations
DATABASE_URL=postgresql://postgres:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:[password]@your-instance.upstash.io:6379

JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=

SENTRY_DSN=

BANNED_WORDS=

POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
